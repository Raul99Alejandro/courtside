{
  "name": "@courtside/vega",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "test": "echo \"no vega unit tests; shared tests run in @courtside/shared\"",
    "test:snapshot": "jest --colors --updateSnapshot",
    "lint": "echo \"no lint config\"",
    "lint:fix": "eslint src test --ext .ts,.tsx --fix",
    "build:release": "react-native build-kepler --build-type Release",
    "build:debug": "react-native build-kepler --build-type Debug",
    "build:app": "npm-run-all build:release",
    "build": "npm-run-all build:release",
    "release": "npm-run-all lint test build:app",
    "typecheck": "node scripts/check-vega.mjs",
    "bundle-check": "node scripts/bundle-check.cjs",
    "check": "node scripts/check-vega.mjs && node scripts/bundle-check.cjs"
  },
  "dependencies": {
    "@amazon-devices/react-native-async-storage__async-storage": "~2.0.0",
    "@amazon-devices/react-native-gesture-handler": "~2.0.0",
    "@amazon-devices/react-native-kepler": "~2.1.0",
    "@amazon-devices/react-native-qrcode-svg": "~2.0.0",
    "@amazon-devices/react-native-reanimated": "~2.0.0",
    "@amazon-devices/react-native-safe-area-context": "~2.0.0",
    "@amazon-devices/react-native-screens": "~2.0.0",
    "@amazon-devices/react-native-svg": "~2.0.0",
    "@amazon-devices/react-navigation__core": "~7.0.0",
    "@amazon-devices/react-navigation__elements": "~7.0.0",
    "@amazon-devices/react-navigation__native": "~7.0.0",
    "@amazon-devices/react-navigation__native-stack": "~7.0.0",
    "@amazon-devices/react-navigation__routers": "~7.0.0",
    "@courtside/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "fast-text-encoding": "^1.0.6",
    "mitt": "^3.0.1",
    "react": "18.2.0",
    "react-native": "0.72.0",
    "react-native-pixel-perfect": "^1.0.2",
    "react-tv-space-navigation": "6.0.0-beta1"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@babel/core": "^7.29.6",
    "@react-native-community/cli": "17.0.1",
    "@react-native/metro-config": "^0.72.6",
    "@tsconfig/react-native": "^3.0.2",
    "@types/react": "^18.0.24",
    "metro-react-native-babel-preset": "^0.76.5",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.7.0"
  },
  "kepler": {
    "projectType": "application",
    "appName": "CourtsideVega",
    "targets": [
      "tv"
    ]
  }
}
