{
  "name": "courtside",
  "version": "1.0.0",
  "description": "Courtside explains a soccer match to everyone in the living room at their own level, on Fire TV. It replays real matches from open play-by-play data on a 2D pitch, explains each moment in layers (basic / intermediate / tactical) per viewer, remembers what each viewer already understood, and lets anyone ask a question by voice from their phone.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "domain:check": "node scripts/check-domain.mjs",
    "data:build": "tsx src/data/build.ts",
    "cards:generate": "tsx src/explain/generate.ts",
    "web:dev": "vite web",
    "web:build": "node scripts/build-web.mjs",
    "cdk": "cdk --app \"npx tsx infra/bin/app.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "aws-cdk": "^2.1144.0",
    "aws-cdk-lib": "^2.272.0",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1146.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "qrcode": "^1.5.4"
  }
}
